classDiagram
    class TargetLanguage {
        <<enumeration>>
        english
        japanese
        korean
        chinese
    }

    class BaseWordRecord {
        <<interface>>
        +string id
        +TargetLanguage language
        +Blob imageBlob
        +string imageUrl
        +string thaiTranslation
        +number createdAt
    }

    class JapaneseWordRecord {
        <<interface>>
        +string kanji
        +string hiragana
        +string romaji
    }

    class KoreanWordRecord {
        <<interface>>
        +string hangul
        +string thaiReading
        +string romanization
    }

    class ChineseWordRecord {
        <<interface>>
        +string hanzi
        +string pinyin
    }

    class EnglishWordRecord {
        <<interface>>
        +string word
        +string ipa
    }

    BaseWordRecord <|-- JapaneseWordRecord : inheritance
    BaseWordRecord <|-- KoreanWordRecord : inheritance
    BaseWordRecord <|-- ChineseWordRecord : inheritance
    BaseWordRecord <|-- EnglishWordRecord : inheritance

    class BaseFeedWord {
        <<interface>>
        +TargetLanguage language
        +string thai
        +string partOfSpeech
    }

    class JapaneseFeedWord {
        <<interface>>
        +string kanji
        +string hiragana
        +string romaji
    }

    class KoreanFeedWord {
        <<interface>>
        +string korean
        +string reading
        +string romanization
        +string english
    }

    class ChineseFeedWord {
        <<interface>>
        +string hanzi
        +string pinyin
    }

    class EnglishFeedWord {
        <<interface>>
        +string word
        +string ipa
    }

    BaseFeedWord <|-- JapaneseFeedWord : inheritance
    BaseFeedWord <|-- KoreanFeedWord : inheritance
    BaseFeedWord <|-- ChineseFeedWord : inheritance
    BaseFeedWord <|-- EnglishFeedWord : inheritance

    class FeedWordRecord {
        <<interface>>
        +string id
        +TargetLanguage language
        +string generatedDate
        +string thai
        +boolean bookmarked
        +Blob imageBlob
        +string imageUrl
        +number createdAt
        +string partOfSpeech
        +string kanji
        +string hiragana
        +string romaji
        +string korean
        +string reading
        +string romanization
        +string english
        +string hanzi
        +string pinyin
        +string word
        +string ipa
    }

    class StudySession {
        <<interface>>
        +string id
        +TargetLanguage language
        +string flashcardSetId
        +number completedAt
        +number cardsReviewed
    }

    BaseWordRecord --> TargetLanguage : uses
    BaseFeedWord --> TargetLanguage : uses
    FeedWordRecord --> TargetLanguage : uses
    StudySession --> TargetLanguage : uses
