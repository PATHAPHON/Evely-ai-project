flowchart LR
  %% Styling definitions for DFD standards
  classDef entity fill:#f9f,stroke:#333,stroke-width:2px;
  classDef process fill:#bbf,stroke:#333,stroke-dasharray: 0,stroke-width:2px;
  classDef datastore fill:#ffd,stroke:#333,stroke-width:2px;

  %% External Entities
  Learner["👤 Learner (User)"]:::entity
  AI_API["🤖 External AI Services (IntelSphere / TTS)"]:::entity

  %% Processes
  subgraph Processes
    P1(["P1: Authenticate & Profile Mgmt"]):::process
    P2(["P2: Process Daily Feed"]):::process
    P3(["P3: Scan & Identify Objects"]):::process
    P4(["P4: Manage Vocab & Flashcards"]):::process
    P5(["P5: Chat & Play Lessons"]):::process
    P6(["P6: Reset User Data"]):::process
  end

  %% Data Stores
  subgraph Data_Stores [Data Stores]
    D1[("D1: Supabase Database")]:::datastore
    D2[("D2: Supabase Storage (Media)")]:::datastore
    D3[("D3: Browser LocalStorage (Config)")]:::datastore
  end

  %% DFD Flows
  %% P1 Flows
  Learner -->|Credentials / Profile info| P1
  P1 -->|Read/Write user profile| D1
  P1 -->|Render profile dashboard / session| Learner

  %% P2 Flows
  Learner -->|Swipe gesture / Bookmark| P2
  P2 -->|Read Target Language / API Keys| D3
  P2 -->|Request vocabulary generation| AI_API
  AI_API -->|Return generated translations & pronunciation| P2
  P2 -->|Save daily feed words & bookmarks| D1
  P2 -->|Upload placeholder image| D2
  P2 -->|Show feed card & rewards| Learner

  %% P3 Flows
  Learner -->|Capture photo blob| P3
  P3 -->|Request object identification| AI_API
  AI_API -->|Return identified label & translations| P3
  P3 -->|Upload object photo| D2
  P3 -->|Save word record| D1
  P3 -->|Reveal identified label| Learner

  %% P4 Flows
  Learner -->|Review cards / Delete word| P4
  D1 -->|Read saved words & flashcard sets| P4
  P4 -->|Update / Soft-delete words| D1
  P4 -->|Show flashcards deck| Learner

  %% P5 Flows
  Learner -->|Send chat message / Answer quiz| P5
  P5 -->|Read conversation history & vocabulary context| D1
  P5 -->|Read custom AI credentials| D3
  P5 -->|Generate AI mascot response / TTS audio| AI_API
  AI_API -->|Return chatbot replies & sound bytes| P5
  P5 -->|Save chat transcripts & award gems| D1
  P5 -->|Render chatbot bubble & play pronunciation| Learner

  %% P6 Flows
  Learner -->|Request Factory Reset| P6
  P6 -->|Delete all database records| D1
  P6 -->|Remove uploaded images| D2
  P6 -->|Clear app preferences| D3
  P6 -->|Confirm data deletion| Learner
