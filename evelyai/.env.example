# ============================================================================
# EvelyAI — Environment Variables Configuration
# ============================================================================
# Copy this file to .env or .env.local and fill in your actual credentials.
#
#   cp .env.example .env
#
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase Configuration (Database & Authentication)
# ----------------------------------------------------------------------------
# Project URL found in your Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public Key: Safe to expose to client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key: Keep SECRET! Used only on server for admin tasks (e.g. account deletion cascade, Stripe webhook)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# 2. AI Providers (LLM, TTS, STT)
# ----------------------------------------------------------------------------
# OpenRouter API Key (Used for LLMs: Google Gemini 3.1 Flash Lite for Chat, Grammar, Word Detail, and Translation; TTS: Google Gemini 3.1 Flash TTS Preview, STT: Whisper)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default Voice Model for Google Gemini 3.1 Flash TTS (e.g. Aoede, Puck, Charon, Kore, Fenrir, Zephyr)
OPENROUTER_TTS_VOICE=Aoede

# ----------------------------------------------------------------------------
# 3. Stripe Billing (Premium Tier Subscriptions)
# ----------------------------------------------------------------------------
# Public Key for Stripe Elements / Checkout client-side
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Secret Key
# NOTE: Set to 'sk_test_mock' to enable offline/mock billing mode during evaluations without real Stripe keys!
STRIPE_SECRET_KEY=sk_test_mock

# Stripe Webhook Signing Secret (from `stripe listen --forward-to localhost:3000/api/stripe/webhook`)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Recurring Price ID for Premium Plan (e.g. price_1TmbyxD4reSLxhKqWxunRT3V)
NEXT_PUBLIC_STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# 4. Optional / Legacy Variables (Not actively used)
# ----------------------------------------------------------------------------
# PEXELS_API_KEY=xxx (Optional: Image assets if enabled)
